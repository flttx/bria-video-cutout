{
  "name": "@bria-cutout/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev:server": "vite --mode server --host localhost --port 8080",
    "dev": "vite --mode server --host localhost --port 8080",
    "dev:browser": "vite --host 127.0.0.1",
    "dev:native": "vite --mode native --host 127.0.0.1 --port 5175",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "build:server": "tsc -p tsconfig.json --noEmit && vite build --mode server",
    "predev:browser": "node ../../scripts/prepare-wasm.mjs",
    "predev:native": "node ../../scripts/prepare-wasm.mjs",
    "prebuild": "node ../../scripts/prepare-wasm.mjs"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.1.0"
  }
}
